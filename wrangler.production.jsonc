{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/a/*", "/og/*", "/fonts/*", "/vendor/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TELEMETRY_ENV": "production",
    "TELEMETRY_LOGS": "enabled",
    "PUBLIC_CREATE_MODE": "disabled",
    "ANONYMOUS_COMMENTS": "disabled",
    "RATE_LIMIT_MODE": "cloudflare",
    "OPEN_ARTIFACTS_WEB_FONTS": "1",
    "OPEN_ARTIFACTS_HANDOFF": "1",
    "KILL_SWITCH_WRITES": "0",
    "KILL_SWITCH_LIVE": "0",
    "KILL_SWITCH_COMMENTS": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-artifacts",
      "database_id": "a01d21cd-86cb-4832-872d-d196e6918a3b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "CONTENT", "bucket_name": "open-artifacts-content" }
  ],
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "open-artifacts-production-metrics" }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "10000003",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE_DO", "class_name": "LiveObject" }]
  },
  "exports": {
    "LiveObject": { "type": "durable-object", "storage": "sqlite" }
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "observability": { "enabled": true }
}
