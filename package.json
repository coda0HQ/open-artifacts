{
  "name": "open-artifacts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev -c wrangler.dev.jsonc",
    "deploy": "node scripts/deploy-gated.mjs",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:ops": "vitest run --config vitest.ops.config.ts",
    "test:security": "vitest run tests/security",
    "test:load": "vitest run --config vitest.ops.config.ts tests/load && playwright test tests/e2e/load-smoke.spec.ts",
    "test:accessibility": "playwright test tests/accessibility",
    "build:viewer": "node scripts/build-viewer-runtime.mjs",
    "check:viewer-runtime": "node scripts/build-viewer-runtime.mjs --check",
    "check:protocol": "node scripts/build-protocol-snapshots.mjs --check",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:environments": "node scripts/check-environments.mjs",
    "check": "biome check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.ops.json",
    "cf-typegen": "wrangler types",
    "test:worker": "vitest run",
    "test:dom": "vitest run tests/worker/bridge.test.ts tests/worker/host-ui.test.ts",
    "test:migrations": "vitest run tests/worker/migration.test.ts tests/worker/schema-compatibility.test.ts tests/integration/d1-cas.test.ts && node scripts/verify-migrations.mjs",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm --registry=https://registry.npmjs.org audit --prod --audit-level moderate",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "rehearse:release": "node scripts/release-rehearsal.mjs",
    "verify": "pnpm check && pnpm check:viewer-runtime && pnpm check:protocol && pnpm check:budgets && pnpm check:docs && pnpm check:environments && pnpm typecheck && pnpm scan:secrets && pnpm test:worker && pnpm test:cli && pnpm test:ops && pnpm test:dom && pnpm test:migrations && pnpm audit:prod && pnpm test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.2",
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.0",
    "esbuild": "0.28.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wrangler": "4.107.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/engine.ts"
  }
}
