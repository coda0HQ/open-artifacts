{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-artifacts.dev/protocol/v1/update-request.schema.json",
  "title": "Open Artifacts v1 update request",
  "type": "object",
  "required": ["content"],
  "properties": {
    "content": { "type": "string", "minLength": 1 },
    "format": { "enum": ["html", "markdown", "react"] },
    "title": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 1000 },
    "favicon": { "type": "string", "minLength": 1 },
    "label": { "type": ["string", "null"], "maxLength": 60 },
    "encrypted": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["salt", "iv", "iterations"],
          "properties": {
            "salt": { "type": "string" },
            "iv": { "type": "string" },
            "iterations": { "type": "integer", "minimum": 1000, "maximum": 10000000 }
          },
          "additionalProperties": false
        }
      ]
    },
    "baseVersion": { "type": ["integer", "null"], "minimum": 1 },
    "force": { "type": "boolean" }
  },
  "additionalProperties": false
}
