{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-artifacts.dev/protocol/v1/live-error.schema.json",
  "title": "Open Artifacts v1 Live error",
  "type": "object",
  "required": ["error", "code"],
  "properties": {
    "error": { "type": "string" },
    "code": {
      "enum": [
        "LIVE_PROTOCOL_UPGRADE_REQUIRED",
        "REVISION_CONFLICT",
        "BASE_VERSION_CONFLICT",
        "LEASE_HELD",
        "CHECKPOINT_CONFLICT"
      ]
    },
    "currentRevision": { "type": "integer", "minimum": 0 },
    "currentVersion": { "type": "integer", "minimum": 1 },
    "supportedVersions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    }
  },
  "additionalProperties": false
}
