{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-artifacts.dev/protocol/v1/live-draft-response.schema.json",
  "title": "Open Artifacts v1 Live draft response",
  "type": "object",
  "required": ["draft"],
  "properties": {
    "draft": {
      "type": "object",
      "required": [
        "artifactId",
        "protocolVersion",
        "revision",
        "baseVersion",
        "state",
        "actorId",
        "leaseOwner",
        "leaseUntil",
        "payload",
        "createdAt",
        "updatedAt",
        "expiresAt",
        "checkpointVersion"
      ],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "protocolVersion": { "const": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "baseVersion": { "type": "integer", "minimum": 1 },
        "state": {
          "enum": ["active", "checkpointed", "conflict", "expired"]
        },
        "actorId": { "type": "string", "minLength": 1 },
        "leaseOwner": { "type": ["string", "null"] },
        "leaseUntil": { "type": ["string", "null"] },
        "payload": {
          "type": "object",
          "required": ["content"],
          "properties": {
            "content": { "type": "string" },
            "format": { "enum": ["html", "markdown", "react"] },
            "title": { "type": "string", "maxLength": 200 },
            "description": { "type": "string", "maxLength": 1000 },
            "favicon": { "type": "string" },
            "label": { "type": ["string", "null"], "maxLength": 60 },
            "encrypted": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["salt", "iv", "iterations"],
                  "properties": {
                    "salt": { "type": "string" },
                    "iv": { "type": "string" },
                    "iterations": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 10000000
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "checkpointVersion": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
